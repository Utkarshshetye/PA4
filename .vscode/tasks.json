{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "java: build",
      "type": "shell",
      "command": "javac",
      "args": [
        "-d",
        "classes",
        "-cp",
        ".:soot-4.6.0-jar-with-dependencies.jar",
        "*.java"
      ],
      "problemMatcher": ["$javac"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "java: run with debug",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp",
        "classes:soot-4.6.0-jar-with-dependencies.jar",
        "MainClass"
      ],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "java: clean",
      "type": "shell",
      "command": "rm",
      "args": [
        "-f",
        "*.class"
      ],
      "group": "build"
    }
  ]
}
